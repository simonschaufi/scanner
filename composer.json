{
	"name": "m12r/typo3-cms-scanner",
	"description": "TYPO3 CMS static file analysis",
	"license": "GPL-2.0-or-later",
	"type": "library",
	"authors": [
		{
			"name": "Christian Kuhn",
			"email": "christian.kuhn@typo3.org"
		},
		{
			"name": "Oliver Hader",
			"email": "oliver.hader@typo3.org"
		},
		{
			"name": "Marcus Schwemer",
			"email": "marcus-dev@schwemer.de"
		}
	],
	"require": {
		"php": "^8.3",
		"nikic/php-parser": "^5.4",
		"symfony/finder": "^7.4"
	},
	"require-dev": {
		"ergebnis/composer-normalize": "^2.54",
		"phpunit/phpunit": "^12.5"
	},
	"autoload": {
		"psr-4": {
			"M12R\\Scanner\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"M12R\\Scanner\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.3.36"
		},
		"sort-packages": true
	}
}
